# BangBangCai Booth Game 环境变量

# 主持登录密码（不设置则启动时随机生成）
HOST_PASSWORD=

# HTTP 服务端口（默认 5173）
PORT=5173

# 应用模式：booth（摊位模式）/ solo（自己玩模式）。也可用 --solo 命令行参数
APP_MODE=booth

# 数据文件存储目录（默认 ./data）
DATA_DIR=./data

# Umami public share URL (visitor regions)
VITE_UMAMI_SHARE_URL=https://stats.example.com/share/REPLACE_ME
